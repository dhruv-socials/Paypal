# ---- PayPal --------------------------------------------------------------
# "mock" runs fully offline with a checkout simulator. "sandbox" calls the real
# PayPal sandbox (create an app at https://developer.paypal.com/dashboard/applications/sandbox).
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Save the buyer's PayPal wallet on the first approved order so later in-limit
# purchases capture without a redirect. Needs "Save payment methods" enabled for
# your sandbox app. Leave false and every purchase goes through PayPal approval.
VAULT_ENABLED=false

# Where PayPal sends the buyer back after approval. Must be reachable by your browser.
PUBLIC_BASE_URL=http://localhost:8000
CURRENCY=USD
BRAND_NAME=Mandate Demo Store

# ---- Agent ---------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_MAX_TURNS=12
HARDENED_PROMPT=true

# ---- Storage -------------------------------------------------------------
DATA_DIR=./var
